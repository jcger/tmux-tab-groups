{
  "manifest_version": 3,
  "version": "1.0.0",
  "description": "Tmux-inspired tab group navigation",
  "permissions": [
    "tabs",
    "tabGroups",
    "activeTab",
    "scripting",
    "bookmarks",
    "windows"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "name": "Tmux Tab Groups",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Tmux Tab Groups - Help",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ],
  "commands": {
    "prefix-key": {
      "suggested_key": {
        "default": "Ctrl+A",
        "mac": "MacCtrl+A",
        "windows": "Ctrl+A",
        "linux": "Ctrl+A"
      },
      "description": "Enter command mode"
    }
  },
  "web_accessible_resources": [
    {
      "matches": ["<all_urls>"],
      "resources": ["fuzzy-finder.css"]
    }
  ]
}
